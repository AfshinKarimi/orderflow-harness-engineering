+package com.orderflow.order.application.service;
+
+import com.orderflow.order.application.port.in.ListOrdersUseCase;
+import com.orderflow.order.application.port.in.OrderResult;
+import com.orderflow.order.application.port.out.OrderRepository;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.util.List;
+import java.util.Objects;
+
+@Service
+@Transactional(readOnly = true)
+public class ListOrdersService implements ListOrdersUseCase {
+
+    private final OrderRepository orderRepository;
+
+    public ListOrdersService(OrderRepository orderRepository) {
+        this.orderRepository = orderRepository;
+    }
+
+    @Override
+    public OrderPage list(ListOrdersQuery query) {
+        Objects.requireNonNull(query, "query");
+        if (query.page() < 0 || query.size() < 1) {
+            throw new IllegalArgumentException("page must be >= 0 and size >= 1");
+        }
+        long total = orderRepository.countByCustomer(query.customerId());
+        List<OrderResult> items = orderRepository.findByCustomer(query.customerId(), query.page(), query.size())
+                .stream().map(OrderResult::from).toList();
+        int totalPages = (int) ((total + query.size() - 1) / query.size());
+        return new OrderPage(items, query.page(), query.size(), total, totalPages);
+    }
+}
