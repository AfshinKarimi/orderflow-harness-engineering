+package com.orderflow.order.application.service;
+
+import com.orderflow.order.application.port.in.ListOrdersUseCase.ListOrdersQuery;
+import com.orderflow.order.application.port.in.ListOrdersUseCase.OrderPage;
+import com.orderflow.order.application.port.in.OrderResult;
+import com.orderflow.order.domain.Order;
+import com.orderflow.order.domain.OrderId;
+import com.orderflow.order.domain.OrderLine;
+import com.orderflow.shared.domain.Money;
+import org.junit.jupiter.api.Test;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+import java.util.UUID;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class ListOrdersServiceTest {
+
+    private static final Instant T0 = Instant.parse("2026-10-30T12:00:00Z");
+
+    private final InMemoryOrderRepository repository = new InMemoryOrderRepository();
+    private final ListOrdersService service = new ListOrdersService(repository);
+
+    @Test
+    void returnsTheRequestedPageNewestFirst() {
+        List<UUID> ids = List.of(save("c-1", 0), save("c-1", 1), save("c-1", 2), save("c-1", 3), save("c-1", 4));
+        save("c-2", 5);
+
+        OrderPage page = service.list(new ListOrdersQuery("c-1", 1, 2));
+
+        assertThat(page.items()).extracting(OrderResult::id).containsExactly(ids.get(2), ids.get(1));
+        assertThat(page.page()).isEqualTo(1);
+        assertThat(page.size()).isEqualTo(2);
+        assertThat(page.totalItems()).isEqualTo(5);
+        assertThat(page.totalPages()).isEqualTo(3);
+    }
+
+    @Test
+    void customerWithoutOrdersHasNoPages() {
+        OrderPage page = service.list(new ListOrdersQuery("nobody", 0, 20));
+
+        assertThat(page.items()).isEmpty();
+        assertThat(page.totalItems()).isZero();
+        assertThat(page.totalPages()).isZero();
+    }
+
+    @Test
+    void rejectsInvalidPaging() {
+        assertThatThrownBy(() -> service.list(new ListOrdersQuery("c-1", -1, 20)))
+                .isInstanceOf(IllegalArgumentException.class);
+        assertThatThrownBy(() -> service.list(new ListOrdersQuery("c-1", 0, 0)))
+                .isInstanceOf(IllegalArgumentException.class);
+    }
+
+    private UUID save(String customer, int minutesAfterT0) {
+        Order order = Order.create(OrderId.newId(), customer,
+                List.of(new OrderLine("p-1", 1, Money.of(new BigDecimal("5.00"), "EUR"))),
+                T0.plusSeconds(60L * minutesAfterT0));
+        repository.save(order);
+        return order.id().value();
+    }
+}
