+package com.orderflow.order.application.service;
+
+import com.orderflow.order.application.port.in.OrderNotFoundException;
+import com.orderflow.order.application.port.in.RequestPaymentUseCase;
+import com.orderflow.order.application.port.out.OrderRepository;
+import com.orderflow.order.domain.Order;
+import com.orderflow.order.domain.OrderId;
+import com.orderflow.order.domain.PaymentAttemptId;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.util.UUID;
+
+/**
+ * Concurrent requests for the same order are safe: both load the same version, and optimistic locking rejects the
+ * second save, so at most one new attempt is stored.
+ */
+@Service
+@Transactional
+public class RequestPaymentService implements RequestPaymentUseCase {
+
+    private final OrderRepository orderRepository;
+
+    public RequestPaymentService(OrderRepository orderRepository) {
+        this.orderRepository = orderRepository;
+    }
+
+    @Override
+    public PaymentAttempt request(UUID orderId) {
+        Order order = orderRepository.findById(new OrderId(orderId))
+                .orElseThrow(() -> new OrderNotFoundException(orderId));
+        PaymentAttemptId before = order.currentPaymentAttempt();
+        PaymentAttemptId attempt = order.requestPayment();
+        if (!attempt.equals(before)) {
+            orderRepository.save(order);
+        }
+        return new PaymentAttempt(orderId, attempt.value(), order.paymentAttempts());
+    }
+}
