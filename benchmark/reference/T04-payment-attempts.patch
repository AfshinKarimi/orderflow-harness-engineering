+package com.orderflow.order.application.port.in;
+
+import java.util.UUID;
+
+public interface RequestPaymentUseCase {
+
+    /**
+     * Starts a payment attempt, or returns the current one while a payment is pending.
+     *
+     * @throws OrderNotFoundException if no order has this ID
+     * @throws com.orderflow.order.domain.InvalidOrderStateException if the order is paid or has no attempts left
+     */
+    PaymentAttempt request(UUID orderId);
+
+    /** @param attemptNumber 1 for the first attempt of the order */
+    record PaymentAttempt(UUID orderId, UUID attemptId, int attemptNumber) {
+    }
+}
