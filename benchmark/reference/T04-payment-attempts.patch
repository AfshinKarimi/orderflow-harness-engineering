+package com.orderflow.order.application.service;
+
+import com.orderflow.order.application.port.in.OrderNotFoundException;
+import com.orderflow.order.application.port.in.RequestPaymentUseCase.PaymentAttempt;
+import com.orderflow.order.domain.InvalidOrderStateException;
+import com.orderflow.order.domain.Order;
+import com.orderflow.order.domain.OrderId;
+import com.orderflow.order.domain.OrderLine;
+import com.orderflow.order.domain.OrderStatus;
+import com.orderflow.order.domain.PaymentAttemptId;
+import com.orderflow.shared.domain.Money;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+import java.util.UUID;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class RequestPaymentServiceTest {
+
+    private final InMemoryOrderRepository repository = new InMemoryOrderRepository();
+    private final RequestPaymentService service = new RequestPaymentService(repository);
+    private Order order;
+
+    @BeforeEach
+    void storedOrder() {
+        order = Order.create(OrderId.newId(), "c-1",
+                List.of(new OrderLine("p-1", 1, Money.of(new BigDecimal("5.00"), "EUR"))),
+                Instant.parse("2026-10-30T12:00:00Z"));
+        repository.save(order);
+        repository.saved.clear();
+    }
+
+    @Test
+    void startsTheFirstAttemptAndSaves() {
+        PaymentAttempt attempt = service.request(order.id().value());
+
+        assertThat(attempt.orderId()).isEqualTo(order.id().value());
+        assertThat(attempt.attemptNumber()).isEqualTo(1);
+        assertThat(repository.saved).singleElement().extracting(Order::status).isEqualTo(OrderStatus.PAYMENT_PENDING);
+    }
+
+    @Test
+    void pendingAttemptIsReturnedWithoutSaving() {
+        PaymentAttempt first = service.request(order.id().value());
+        repository.saved.clear();
+
+        assertThat(service.request(order.id().value())).isEqualTo(first);
+        assertThat(repository.saved).isEmpty();
+    }
+
+    @Test
+    void retryAfterFailureIsTheNextAttempt() {
+        PaymentAttempt first = service.request(order.id().value());
+        order.markPaymentFailed(new PaymentAttemptId(first.attemptId()));
+
+        PaymentAttempt second = service.request(order.id().value());
+
+        assertThat(second.attemptNumber()).isEqualTo(2);
+        assertThat(second.attemptId()).isNotEqualTo(first.attemptId());
+    }
+
+    @Test
+    void rejectedRequestIsNotSaved() {
+        order.markPaid(order.requestPayment());
+
+        assertThatThrownBy(() -> service.request(order.id().value())).isInstanceOf(InvalidOrderStateException.class);
+        assertThat(repository.saved).isEmpty();
+    }
+
+    @Test
+    void unknownOrderIsAnError() {
+        UUID unknown = UUID.randomUUID();
+
+        assertThatThrownBy(() -> service.request(unknown)).isInstanceOf(OrderNotFoundException.class);
+    }
+}
