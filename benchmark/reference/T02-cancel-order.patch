+package com.orderflow.order.application.port.in;
+
+import java.util.UUID;
+
+public interface CancelOrderUseCase {
+
+    /**
+     * Cancels the order, or returns it unchanged if it is already cancelled.
+     *
+     * @throws OrderNotFoundException if no order has this ID
+     * @throws com.orderflow.order.domain.InvalidOrderStateException if a payment is pending or the order is paid
+     */
+    OrderResult cancel(UUID orderId);
+}
