@@ -0,0 +1,8 @@
+-- Cancelled orders (T02): an order cancelled before any payment has no attempt, one cancelled after a failed
+-- payment keeps it. The other statuses keep the rule from V4.
+ALTER TABLE orders.orders DROP CONSTRAINT orders_payment_attempt_matches_status;
+
+ALTER TABLE orders.orders ADD CONSTRAINT orders_payment_attempt_matches_status CHECK (
+    status = 'CANCELLED'
+    OR (status = 'CREATED' AND payment_attempt_id IS NULL)
+    OR (status IN ('PAYMENT_PENDING', 'PAID', 'PAYMENT_FAILED') AND payment_attempt_id IS NOT NULL));
