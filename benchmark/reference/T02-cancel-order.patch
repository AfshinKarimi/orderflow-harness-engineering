+package com.orderflow.order.domain;
+
+import com.orderflow.shared.domain.Money;
+import org.junit.jupiter.api.Test;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+/** Cancellation of the Order aggregate, from every status. */
+class OrderCancellationTest {
+
+    private final Order order = Order.create(OrderId.newId(), "c-1",
+            List.of(new OrderLine("p-1", 1, Money.of(new BigDecimal("5.00"), "EUR"))),
+            Instant.parse("2026-10-30T12:00:00Z"));
+
+    @Test
+    void createdOrderCanBeCancelled() {
+        assertThat(order.cancel()).isTrue();
+
+        assertThat(order.status()).isEqualTo(OrderStatus.CANCELLED);
+    }
+
+    @Test
+    void orderWhosePaymentFailedCanBeCancelled() {
+        order.markPaymentFailed(order.requestPayment());
+
+        assertThat(order.cancel()).isTrue();
+        assertThat(order.status()).isEqualTo(OrderStatus.CANCELLED);
+    }
+
+    @Test
+    void cancellingAgainChangesNothing() {
+        order.cancel();
+
+        assertThat(order.cancel()).isFalse();
+        assertThat(order.status()).isEqualTo(OrderStatus.CANCELLED);
+    }
+
+    @Test
+    void orderWithPendingPaymentCannotBeCancelled() {
+        order.requestPayment();
+
+        assertThatThrownBy(order::cancel)
+                .isInstanceOf(InvalidOrderStateException.class)
+                .hasMessageContaining("cannot be cancelled in status PAYMENT_PENDING");
+        assertThat(order.status()).isEqualTo(OrderStatus.PAYMENT_PENDING);
+    }
+
+    @Test
+    void paidOrderCannotBeCancelled() {
+        order.markPaid(order.requestPayment());
+
+        assertThatThrownBy(order::cancel)
+                .isInstanceOf(InvalidOrderStateException.class)
+                .hasMessageContaining("cannot be cancelled in status PAID");
+    }
+
+    @Test
+    void cancelledOrderCannotRequestPayment() {
+        order.cancel();
+
+        assertThatThrownBy(order::requestPayment)
+                .isInstanceOf(InvalidOrderStateException.class)
+                .hasMessageContaining("is cancelled");
+    }
+
+    @Test
+    void lateFailureForACancelledOrderIsIgnored() {
+        PaymentAttemptId attempt = order.requestPayment();
+        order.markPaymentFailed(attempt);
+        order.cancel();
+
+        assertThat(order.markPaymentFailed(attempt)).isFalse();
+        assertThat(order.status()).isEqualTo(OrderStatus.CANCELLED);
+    }
+
+    @Test
+    void lateSuccessForACancelledOrderIsRejectedForRefund() {
+        PaymentAttemptId attempt = order.requestPayment();
+        order.markPaymentFailed(attempt);
+        order.cancel();
+
+        assertThatThrownBy(() -> order.markPaid(attempt))
+                .isInstanceOf(InvalidOrderStateException.class)
+                .hasMessageContaining("refund required");
+        assertThat(order.status()).isEqualTo(OrderStatus.CANCELLED);
+    }
+
+    @Test
+    void cancelledOrderIsRestoredWithOrWithoutAnAttempt() {
+        Order withoutAttempt = Order.restore(OrderId.newId(), "c-1", order.lines(), OrderStatus.CANCELLED, null,
+                order.createdAt(), 1);
+        Order withAttempt = Order.restore(OrderId.newId(), "c-1", order.lines(), OrderStatus.CANCELLED,
+                PaymentAttemptId.newId(), order.createdAt(), 2);
+
+        assertThat(withoutAttempt.status()).isEqualTo(OrderStatus.CANCELLED);
+        assertThat(withAttempt.currentPaymentAttempt()).isNotNull();
+    }
+}
