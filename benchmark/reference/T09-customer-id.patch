@@ -0,0 +1,36 @@
+package com.orderflow.order.domain;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class CustomerIdTest {
+
+    @Test
+    void wrapsTheValue() {
+        assertThat(new CustomerId("c-1").value()).isEqualTo("c-1");
+        assertThat(new CustomerId("c-1")).isEqualTo(new CustomerId("c-1"));
+    }
+
+    @Test
+    void acceptsTheMaximumLength() {
+        assertThat(new CustomerId("c".repeat(100)).value()).hasSize(100);
+    }
+
+    @Test
+    void rejectsMissingOrBlankValues() {
+        for (String blank : new String[] {null, "", "  "}) {
+            assertThatThrownBy(() -> new CustomerId(blank))
+                    .isInstanceOf(InvalidOrderException.class)
+                    .hasMessage("Customer ID is required");
+        }
+    }
+
+    @Test
+    void rejectsValuesLongerThanTheColumn() {
+        assertThatThrownBy(() -> new CustomerId("c".repeat(101)))
+                .isInstanceOf(InvalidOrderException.class)
+                .hasMessage("Customer ID must have at most 100 characters");
+    }
+}
