@@ -0,0 +1,16 @@
+package com.orderflow.order.domain;
+
+/** Identifies the customer who placed an order. At most 100 characters (the size of the database column). */
+public record CustomerId(String value) {
+
+    static final int MAX_LENGTH = 100;
+
+    public CustomerId {
+        if (value == null || value.isBlank()) {
+            throw new InvalidOrderException("Customer ID is required");
+        }
+        if (value.length() > MAX_LENGTH) {
+            throw new InvalidOrderException("Customer ID must have at most " + MAX_LENGTH + " characters");
+        }
+    }
+}
