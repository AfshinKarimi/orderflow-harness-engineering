diff --git a/src/test/java/com/orderflow/order/domain/ShippingAddressTest.java b/src/test/java/com/orderflow/order/domain/ShippingAddressTest.java
new file mode 100644
index 0000000..8f27202
--- /dev/null
+++ b/src/test/java/com/orderflow/order/domain/ShippingAddressTest.java
@@ -0,0 +1,50 @@
+package com.orderflow.order.domain;
+
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class ShippingAddressTest {
+
+    @Test
+    void acceptsACompleteAddress() {
+        ShippingAddress address = new ShippingAddress("Main St 1", "Berlin", "10115", "DE");
+
+        assertThat(address.country()).isEqualTo("DE");
+    }
+
+    @Test
+    void acceptsMaximumLengths() {
+        ShippingAddress address = new ShippingAddress("s".repeat(200), "c".repeat(100), "p".repeat(20), "FR");
+
+        assertThat(address.street()).hasSize(200);
+    }
+
+    @Test
+    void rejectsMissingParts() {
+        assertThatThrownBy(() -> new ShippingAddress(" ", "Berlin", "10115", "DE"))
+                .isInstanceOf(InvalidOrderException.class).hasMessage("Street is required");
+        assertThatThrownBy(() -> new ShippingAddress("Main St 1", null, "10115", "DE"))
+                .isInstanceOf(InvalidOrderException.class).hasMessage("City is required");
+        assertThatThrownBy(() -> new ShippingAddress("Main St 1", "Berlin", "", "DE"))
+                .isInstanceOf(InvalidOrderException.class).hasMessage("Postal code is required");
+    }
+
+    @Test
+    void rejectsTooLongParts() {
+        assertThatThrownBy(() -> new ShippingAddress("s".repeat(201), "Berlin", "10115", "DE"))
+                .isInstanceOf(InvalidOrderException.class).hasMessage("Street must have at most 200 characters");
+        assertThatThrownBy(() -> new ShippingAddress("Main St 1", "Berlin", "1".repeat(21), "DE"))
+                .isInstanceOf(InvalidOrderException.class).hasMessage("Postal code must have at most 20 characters");
+    }
+
+    @Test
+    void rejectsCountriesThatAreNotIsoAlpha2Codes() {
+        for (String country : new String[] {"de", "DEU", "XX", null}) {
+            assertThatThrownBy(() -> new ShippingAddress("Main St 1", "Berlin", "10115", country))
+                    .isInstanceOf(InvalidOrderException.class)
+                    .hasMessageStartingWith("Country must be an ISO 3166-1 alpha-2 code");
+        }
+    }
+}
