diff --git a/src/main/java/com/orderflow/order/domain/ShippingAddress.java b/src/main/java/com/orderflow/order/domain/ShippingAddress.java
new file mode 100644
index 0000000..3ff3149
--- /dev/null
+++ b/src/main/java/com/orderflow/order/domain/ShippingAddress.java
@@ -0,0 +1,29 @@
+package com.orderflow.order.domain;
+
+import java.util.Locale;
+import java.util.Set;
+
+/** Where an order is shipped to. {@code country} is an ISO 3166-1 alpha-2 code in upper case. */
+public record ShippingAddress(String street, String city, String postalCode, String country) {
+
+    private static final Set<String> COUNTRIES = Set.of(Locale.getISOCountries());
+
+    public ShippingAddress {
+        street = require(street, "Street", 200);
+        city = require(city, "City", 100);
+        postalCode = require(postalCode, "Postal code", 20);
+        if (country == null || !COUNTRIES.contains(country)) {
+            throw new InvalidOrderException("Country must be an ISO 3166-1 alpha-2 code, got " + country);
+        }
+    }
+
+    private static String require(String value, String name, int maxLength) {
+        if (value == null || value.isBlank()) {
+            throw new InvalidOrderException(name + " is required");
+        }
+        if (value.length() > maxLength) {
+            throw new InvalidOrderException(name + " must have at most " + maxLength + " characters");
+        }
+        return value;
+    }
+}
diff --git a/src/main/resources/db/migration/V6__add_order_shipping_address.sql b/src/main/resources/db/migration/V6__add_order_shipping_address.sql
new file mode 100644
index 0000000..b45847d
--- /dev/null
+++ b/src/main/resources/db/migration/V6__add_order_shipping_address.sql
@@ -0,0 +1,12 @@
+-- Shipping address (T05). Nullable: orders created before this migration have none.
+-- New orders always have all four parts (enforced by the domain); the CHECK rejects partial addresses.
+ALTER TABLE orders.orders
+    ADD COLUMN shipping_street      VARCHAR(200),
+    ADD COLUMN shipping_city        VARCHAR(100),
+    ADD COLUMN shipping_postal_code VARCHAR(20),
+    ADD COLUMN shipping_country     VARCHAR(2);
+
+ALTER TABLE orders.orders ADD CONSTRAINT orders_shipping_address_complete CHECK (
+    (shipping_street IS NULL AND shipping_city IS NULL AND shipping_postal_code IS NULL AND shipping_country IS NULL)
+    OR (shipping_street IS NOT NULL AND shipping_city IS NOT NULL AND shipping_postal_code IS NOT NULL
+        AND shipping_country IS NOT NULL));
