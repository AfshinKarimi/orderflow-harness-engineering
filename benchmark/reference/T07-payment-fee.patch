+package com.orderflow.payment.domain;
+
+import com.orderflow.shared.domain.Money;
+import org.junit.jupiter.api.Test;
+
+import java.math.BigDecimal;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class FeePolicyTest {
+
+    @Test
+    void feeIsOnePointFivePercent() {
+        assertThat(FeePolicy.feeFor(eur("120.00"))).isEqualTo(eur("1.80"));
+    }
+
+    @Test
+    void roundsHalfUpToTwoDecimals() {
+        assertThat(FeePolicy.feeFor(eur("103.00"))).isEqualTo(eur("1.55"));
+        assertThat(FeePolicy.feeFor(eur("1234.57"))).isEqualTo(eur("18.52"));
+    }
+
+    @Test
+    void feeIsAtLeastFiftyCents() {
+        assertThat(FeePolicy.feeFor(eur("10.00"))).isEqualTo(eur("0.50"));
+        assertThat(FeePolicy.feeFor(eur("33.33"))).isEqualTo(eur("0.50"));
+    }
+
+    @Test
+    void minimumIsReachedExactly() {
+        assertThat(FeePolicy.feeFor(eur("33.34"))).isEqualTo(eur("0.50")); // 0.5001
+        assertThat(FeePolicy.feeFor(eur("34.00"))).isEqualTo(eur("0.51"));
+    }
+
+    @Test
+    void feeIsInTheOrderCurrency() {
+        assertThat(FeePolicy.feeFor(Money.of(new BigDecimal("200.00"), "USD")).currency().getCurrencyCode())
+                .isEqualTo("USD");
+    }
+
+    private static Money eur(String amount) {
+        return Money.of(new BigDecimal(amount), "EUR");
+    }
+}
