+package com.orderflow.order.adapter.in.web;
+
+import com.orderflow.order.application.port.in.GetOrderUseCase;
+import com.orderflow.order.application.port.in.OrderNotFoundException;
+import com.orderflow.order.application.port.in.OrderResult;
+import com.orderflow.payment.application.port.in.QuoteFeeUseCase;
+import com.orderflow.payment.application.port.in.QuoteFeeUseCase.FeeQuote;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
+import org.springframework.http.MediaType;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.test.web.servlet.MockMvc;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+import java.util.UUID;
+
+import static org.mockito.Mockito.verifyNoInteractions;
+import static org.mockito.Mockito.when;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+@WebMvcTest(PaymentFeeController.class)
+class PaymentFeeControllerIT {
+
+    private static final UUID ORDER_ID = UUID.fromString("0b6f5a52-3c4e-4d0a-9a43-6d8f1f0e2a11");
+
+    @Autowired
+    private MockMvc mockMvc;
+
+    @MockitoBean
+    private GetOrderUseCase getOrderUseCase;
+
+    @MockitoBean
+    private QuoteFeeUseCase quoteFeeUseCase;
+
+    @Test
+    void quotesTheFeeForTheOrderTotal() throws Exception {
+        when(getOrderUseCase.get(ORDER_ID)).thenReturn(new OrderResult(ORDER_ID, "c-1", "CREATED", "EUR",
+                new BigDecimal("120.00"), List.of(), Instant.parse("2026-10-30T12:00:00Z")));
+        when(quoteFeeUseCase.quote(new BigDecimal("120.00"), "EUR"))
+                .thenReturn(new FeeQuote(new BigDecimal("1.80"), "EUR"));
+
+        mockMvc.perform(get("/api/v1/payments/fees").param("orderId", ORDER_ID.toString()))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.orderId").value(ORDER_ID.toString()))
+                .andExpect(jsonPath("$.currency").value("EUR"))
+                .andExpect(jsonPath("$.orderTotal").value(120.00))
+                .andExpect(jsonPath("$.fee").value(1.80));
+    }
+
+    @Test
+    void unknownOrderIs404Problem() throws Exception {
+        when(getOrderUseCase.get(ORDER_ID)).thenThrow(new OrderNotFoundException(ORDER_ID));
+
+        mockMvc.perform(get("/api/v1/payments/fees").param("orderId", ORDER_ID.toString()))
+                .andExpect(status().isNotFound())
+                .andExpect(content().contentType(MediaType.APPLICATION_PROBLEM_JSON));
+    }
+
+    @Test
+    void missingOrInvalidOrderIdIs400Problem() throws Exception {
+        mockMvc.perform(get("/api/v1/payments/fees"))
+                .andExpect(status().isBadRequest())
+                .andExpect(content().contentType(MediaType.APPLICATION_PROBLEM_JSON));
+        mockMvc.perform(get("/api/v1/payments/fees").param("orderId", "abc"))
+                .andExpect(status().isBadRequest())
+                .andExpect(content().contentType(MediaType.APPLICATION_PROBLEM_JSON));
+
+        verifyNoInteractions(getOrderUseCase, quoteFeeUseCase);
+    }
+}
