+package com.orderflow.payment.application.service;
+
+import com.orderflow.payment.application.port.in.QuoteFeeUseCase.FeeQuote;
+import org.junit.jupiter.api.Test;
+
+import java.math.BigDecimal;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class QuoteFeeServiceTest {
+
+    private final QuoteFeeService service = new QuoteFeeService();
+
+    @Test
+    void quotesTheFeeInTheOrderCurrency() {
+        FeeQuote quote = service.quote(new BigDecimal("120.00"), "USD");
+
+        assertThat(quote.fee()).isEqualByComparingTo("1.80");
+        assertThat(quote.currency()).isEqualTo("USD");
+    }
+}
