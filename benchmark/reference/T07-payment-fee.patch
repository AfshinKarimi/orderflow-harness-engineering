+package com.orderflow.payment.application.service;
+
+import com.orderflow.payment.application.port.in.QuoteFeeUseCase;
+import com.orderflow.payment.domain.FeePolicy;
+import com.orderflow.shared.domain.Money;
+import org.springframework.stereotype.Service;
+
+import java.math.BigDecimal;
+
+@Service
+public class QuoteFeeService implements QuoteFeeUseCase {
+
+    @Override
+    public FeeQuote quote(BigDecimal orderTotal, String currency) {
+        Money fee = FeePolicy.feeFor(Money.of(orderTotal, currency));
+        return new FeeQuote(fee.amount(), fee.currency().getCurrencyCode());
+    }
+}
