+package com.orderflow.payment.domain;
+
+import com.orderflow.shared.domain.Money;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.Objects;
+
+/** Payment fee: 1.5 % of the order total, rounded half-up to 2 decimals, at least 0.50. */
+public final class FeePolicy {
+
+    static final BigDecimal RATE = new BigDecimal("0.015");
+    static final BigDecimal MINIMUM = new BigDecimal("0.50");
+
+    private FeePolicy() {
+    }
+
+    public static Money feeFor(Money orderTotal) {
+        Objects.requireNonNull(orderTotal, "orderTotal");
+        BigDecimal fee = orderTotal.amount().multiply(RATE).setScale(2, RoundingMode.HALF_UP);
+        return new Money(fee.max(MINIMUM), orderTotal.currency());
+    }
+}
