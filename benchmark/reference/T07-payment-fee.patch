+package com.orderflow.order.adapter.in.web;
+
+import com.orderflow.order.application.port.in.GetOrderUseCase;
+import com.orderflow.order.application.port.in.OrderResult;
+import com.orderflow.payment.application.port.in.QuoteFeeUseCase;
+import com.orderflow.payment.application.port.in.QuoteFeeUseCase.FeeQuote;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+import java.math.BigDecimal;
+import java.util.UUID;
+
+/**
+ * Fee quote for an order. Served by the order module because the order total lives here: the order module may call
+ * the payment module's public API, but not the other way round (order already consumes payment events, so a call
+ * from payment to order would be a module cycle, architecture rule 9). The fee policy itself belongs to payment.
+ */
+@RestController
+class PaymentFeeController {
+
+    private final GetOrderUseCase getOrderUseCase;
+    private final QuoteFeeUseCase quoteFeeUseCase;
+
+    PaymentFeeController(GetOrderUseCase getOrderUseCase, QuoteFeeUseCase quoteFeeUseCase) {
+        this.getOrderUseCase = getOrderUseCase;
+        this.quoteFeeUseCase = quoteFeeUseCase;
+    }
+
+    @GetMapping("/api/v1/payments/fees")
+    PaymentFeeResponse quote(@RequestParam UUID orderId) {
+        OrderResult order = getOrderUseCase.get(orderId);
+        FeeQuote quote = quoteFeeUseCase.quote(order.totalAmount(), order.currency());
+        return new PaymentFeeResponse(order.id(), order.currency(), order.totalAmount(), quote.fee());
+    }
+
+    record PaymentFeeResponse(UUID orderId, String currency, BigDecimal orderTotal, BigDecimal fee) {
+    }
+}
