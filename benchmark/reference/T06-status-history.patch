diff --git a/src/test/java/com/orderflow/order/domain/OrderStatusHistoryTest.java b/src/test/java/com/orderflow/order/domain/OrderStatusHistoryTest.java
new file mode 100644
index 0000000..8c7277e
--- /dev/null
+++ b/src/test/java/com/orderflow/order/domain/OrderStatusHistoryTest.java
@@ -0,0 +1,54 @@
+package com.orderflow.order.domain;
+
+import com.orderflow.shared.domain.Money;
+import org.junit.jupiter.api.Test;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class OrderStatusHistoryTest {
+
+    private static final Instant T0 = Instant.parse("2026-10-30T12:00:00Z");
+    private static final Instant T1 = T0.plusSeconds(60);
+    private static final Instant T2 = T0.plusSeconds(120);
+
+    private final Order order = Order.create(OrderId.newId(), "c-1",
+            List.of(new OrderLine("p-1", 1, Money.of(new BigDecimal("5.00"), "EUR"))), T0);
+
+    @Test
+    void creationIsTheFirstEntry() {
+        assertThat(order.statusHistory()).containsExactly(new StatusChange(OrderStatus.CREATED, T0));
+    }
+
+    @Test
+    void everyStatusChangeIsRecorded() {
+        order.markPaid(order.requestPayment(T1), T2);
+
+        assertThat(order.statusHistory()).containsExactly(
+                new StatusChange(OrderStatus.CREATED, T0),
+                new StatusChange(OrderStatus.PAYMENT_PENDING, T1),
+                new StatusChange(OrderStatus.PAID, T2));
+    }
+
+    @Test
+    void transitionsThatChangeNothingAddNoEntry() {
+        PaymentAttemptId attempt = order.requestPayment(T1);
+        order.requestPayment(T2);
+        order.markPaymentFailed(attempt, T2);
+        order.markPaymentFailed(attempt, T2);
+        order.markPaymentFailed(PaymentAttemptId.newId(), T2);
+
+        assertThat(order.statusHistory()).extracting(StatusChange::status)
+                .containsExactly(OrderStatus.CREATED, OrderStatus.PAYMENT_PENDING, OrderStatus.PAYMENT_FAILED);
+    }
+
+    @Test
+    void historyCannotBeModifiedFromOutside() {
+        List<StatusChange> history = order.statusHistory();
+
+        assertThat(history).isUnmodifiable();
+    }
+}
