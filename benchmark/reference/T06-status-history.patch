+package com.orderflow.order.domain;
+
+import java.time.Instant;
+import java.util.Objects;
+
+/** One entry of an order's status history: the status it changed to, and when. */
+public record StatusChange(OrderStatus status, Instant changedAt) {
+
+    public StatusChange {
+        Objects.requireNonNull(status, "status");
+        Objects.requireNonNull(changedAt, "changedAt");
+    }
+}
diff --git a/src/main/resources/db/migration/V6__create_order_status_history.sql b/src/main/resources/db/migration/V6__create_order_status_history.sql
new file mode 100644
index 0000000..3fa28ef
--- /dev/null
+++ b/src/main/resources/db/migration/V6__create_order_status_history.sql
@@ -0,0 +1,12 @@
+-- Status history of each order (T06), written in the same transaction as the order itself.
+CREATE TABLE orders.order_status_history (
+    order_id   UUID        NOT NULL REFERENCES orders.orders (id) ON DELETE CASCADE,
+    seq        INT         NOT NULL,
+    status     VARCHAR(20) NOT NULL,
+    changed_at TIMESTAMPTZ NOT NULL,
+    PRIMARY KEY (order_id, seq)
+);
+
+-- Existing orders: their history starts with the creation (earlier changes were not recorded).
+INSERT INTO orders.order_status_history (order_id, seq, status, changed_at)
+SELECT id, 0, 'CREATED', created_at FROM orders.orders;
