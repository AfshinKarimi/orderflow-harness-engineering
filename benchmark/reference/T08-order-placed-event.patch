+package com.orderflow.order.adapter.out.event;
+
+import com.orderflow.order.application.event.OrderEvents;
+import com.orderflow.order.application.event.OrderPlaced;
+import com.orderflow.order.application.port.out.OrderEventPublisher;
+import com.orderflow.platform.messaging.api.OutboxWriter;
+import org.springframework.stereotype.Component;
+
+/** Writes events to the transactional outbox (ADR-0003); the relay publishes them to Kafka after commit. */
+@Component
+class OutboxOrderEventPublisher implements OrderEventPublisher {
+
+    private final OutboxWriter outboxWriter;
+
+    OutboxOrderEventPublisher(OutboxWriter outboxWriter) {
+        this.outboxWriter = outboxWriter;
+    }
+
+    @Override
+    public void orderPlaced(OrderPlaced event) {
+        outboxWriter.append(OrderEvents.TOPIC, event.orderId().toString(), event);
+    }
+}
