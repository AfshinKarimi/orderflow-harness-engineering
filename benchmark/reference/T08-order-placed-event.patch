+package com.orderflow.payment.adapter.out.persistence;
+
+import com.orderflow.payment.application.port.out.OrdersAwaitingPayment;
+import com.orderflow.payment.domain.OrderAwaitingPayment;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Component;
+
+import java.sql.Timestamp;
+import java.time.Instant;
+
+@Component
+class JdbcOrdersAwaitingPayment implements OrdersAwaitingPayment {
+
+    private final JdbcTemplate jdbcTemplate;
+
+    JdbcOrdersAwaitingPayment(JdbcTemplate jdbcTemplate) {
+        this.jdbcTemplate = jdbcTemplate;
+    }
+
+    /** ON CONFLICT: an order is recorded once, even if it was announced twice under different event IDs. */
+    @Override
+    public void add(OrderAwaitingPayment order, Instant receivedAt) {
+        jdbcTemplate.update("""
+                        INSERT INTO payment.orders_awaiting_payment
+                            (order_id, currency, total_amount, placed_at, received_at)
+                        VALUES (?, ?, ?, ?, ?)
+                        ON CONFLICT (order_id) DO NOTHING""",
+                order.orderId(), order.total().currency().getCurrencyCode(), order.total().amount(),
+                Timestamp.from(order.placedAt()), Timestamp.from(receivedAt));
+    }
+}
