diff --git a/src/main/java/com/orderflow/payment/adapter/in/event/OrderPlacedListener.java b/src/main/java/com/orderflow/payment/adapter/in/event/OrderPlacedListener.java
new file mode 100644
index 0000000..c2122c3
--- /dev/null
+++ b/src/main/java/com/orderflow/payment/adapter/in/event/OrderPlacedListener.java
@@ -0,0 +1,70 @@
+package com.orderflow.payment.adapter.in.event;
+
+import com.orderflow.payment.application.port.in.RecordOrderAwaitingPaymentUseCase;
+import com.orderflow.payment.application.port.in.RecordOrderAwaitingPaymentUseCase.PlacedOrder;
+import org.apache.kafka.clients.consumer.ConsumerRecord;
+import org.apache.kafka.common.header.Header;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.kafka.annotation.KafkaListener;
+import org.springframework.stereotype.Component;
+import tools.jackson.databind.json.JsonMapper;
+
+import java.math.BigDecimal;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.util.UUID;
+
+/**
+ * Consumes OrderPlaced from the order module. The topic, headers and JSON are the contract: the payment module
+ * reads them into its own record instead of importing the order module's event class, because the order module
+ * already depends on payment's events and an import would create a module cycle (architecture rule 9).
+ */
+@Component
+class OrderPlacedListener {
+
+    /** Same values as order's {@code OrderEvents}; duplicated on purpose (see class comment). */
+    static final String TOPIC = "orderflow.order.events";
+    static final String ORDER_PLACED = "OrderPlaced";
+
+    private static final Logger LOG = LoggerFactory.getLogger(OrderPlacedListener.class);
+
+    private final RecordOrderAwaitingPaymentUseCase recordOrder;
+    private final JsonMapper jsonMapper;
+
+    OrderPlacedListener(RecordOrderAwaitingPaymentUseCase recordOrder, JsonMapper jsonMapper) {
+        this.recordOrder = recordOrder;
+        this.jsonMapper = jsonMapper;
+    }
+
+    @KafkaListener(topics = TOPIC, groupId = "orderflow-payment")
+    void onOrderEvent(ConsumerRecord<String, String> record) {
+        if (!ORDER_PLACED.equals(header(record, "eventType"))) {
+            return;
+        }
+        UUID eventId = UUID.fromString(require(header(record, "eventId"), "eventId header", record));
+        OrderPlacedMessage message = jsonMapper.readValue(record.value(), OrderPlacedMessage.class);
+        recordOrder.record(new PlacedOrder(eventId, require(message.orderId(), "orderId", record),
+                require(message.currency(), "currency", record), require(message.totalAmount(), "totalAmount", record),
+                require(message.placedAt(), "placedAt", record)));
+        LOG.info("Order {} awaiting payment", message.orderId());
+    }
+
+    /** The fields the payment module needs; others (e.g. customerId) are ignored. */
+    record OrderPlacedMessage(UUID orderId, String currency, BigDecimal totalAmount, Instant placedAt) {
+    }
+
+    /** @throws IllegalArgumentException (not retried, dead-lettered) if a required value is missing */
+    private static <T> T require(T value, String name, ConsumerRecord<?, ?> record) {
+        if (value == null) {
+            throw new IllegalArgumentException("Missing " + name + " in event at " + record.topic() + "-"
+                    + record.partition() + "@" + record.offset());
+        }
+        return value;
+    }
+
+    private static String header(ConsumerRecord<?, ?> record, String name) {
+        Header header = record.headers().lastHeader(name);
+        return header == null ? null : new String(header.value(), StandardCharsets.UTF_8);
+    }
+}
