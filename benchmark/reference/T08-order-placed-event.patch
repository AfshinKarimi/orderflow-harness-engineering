--- /dev/null
+++ b/src/test/java/com/orderflow/payment/adapter/in/event/OrderPlacedListenerIT.java
@@ -0,0 +1,63 @@
+package com.orderflow.payment.adapter.in.event;
+
+import com.orderflow.KafkaTestcontainersConfiguration;
+import com.orderflow.TestcontainersConfiguration;
+import org.apache.kafka.clients.producer.ProducerRecord;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.context.annotation.Import;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.kafka.core.KafkaTemplate;
+
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.util.UUID;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.awaitility.Awaitility.await;
+
+/** OrderPlaced consumed by the payment module through the real listener, Kafka and PostgreSQL. */
+@SpringBootTest
+@AutoConfigureMockMvc
+@Import({TestcontainersConfiguration.class, KafkaTestcontainersConfiguration.class})
+class OrderPlacedListenerIT {
+
+    @Autowired
+    private KafkaTemplate<String, String> kafkaTemplate;
+
+    @Autowired
+    private JdbcTemplate jdbcTemplate;
+
+    @Test
+    void storesThePlacedOrderOnceEvenIfRedelivered() {
+        UUID orderId = UUID.randomUUID();
+        UUID eventId = UUID.randomUUID();
+        UUID marker = UUID.randomUUID();
+
+        publish(eventId, orderId);
+        publish(eventId, orderId);
+        publish(UUID.randomUUID(), marker);
+
+        await().atMost(Duration.ofSeconds(30)).until(() -> rows(marker) == 1);
+        assertThat(rows(orderId)).isEqualTo(1);
+        assertThat(jdbcTemplate.queryForObject(
+                "SELECT total_amount FROM payment.orders_awaiting_payment WHERE order_id = ?", String.class, orderId))
+                .isEqualTo("39.9800");
+    }
+
+    private void publish(UUID eventId, UUID orderId) {
+        ProducerRecord<String, String> record = new ProducerRecord<>(OrderPlacedListener.TOPIC, orderId.toString(),
+                "{\"orderId\":\"" + orderId + "\",\"customerId\":\"c-1\",\"currency\":\"EUR\","
+                        + "\"totalAmount\":39.98,\"placedAt\":\"2026-10-30T12:00:00Z\"}");
+        record.headers().add("eventId", eventId.toString().getBytes(StandardCharsets.UTF_8));
+        record.headers().add("eventType", OrderPlacedListener.ORDER_PLACED.getBytes(StandardCharsets.UTF_8));
+        kafkaTemplate.send(record).join();
+    }
+
+    private int rows(UUID orderId) {
+        return jdbcTemplate.queryForObject(
+                "SELECT count(*) FROM payment.orders_awaiting_payment WHERE order_id = ?", Integer.class, orderId);
+    }
+}
