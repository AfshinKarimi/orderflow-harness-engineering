+import com.orderflow.payment.domain.OrderAwaitingPayment;
+import com.orderflow.shared.domain.Money;
+import org.junit.jupiter.api.Test;
+
+import java.math.BigDecimal;
+import java.time.Clock;
+import java.time.Instant;
+import java.time.ZoneOffset;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.UUID;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class RecordOrderAwaitingPaymentServiceTest {
+
+    private static final Instant PLACED = Instant.parse("2026-10-30T12:00:00Z");
+    private static final Instant NOW = Instant.parse("2026-10-30T12:00:01Z");
+
+    private final Set<UUID> processed = new HashSet<>();
+    private final List<OrderAwaitingPayment> stored = new ArrayList<>();
+    private final PaymentProcessedEventStore processedEvents = processed::add;
+    private final OrdersAwaitingPayment orders = (order, receivedAt) -> stored.add(order);
+    private final RecordOrderAwaitingPaymentService service =
+            new RecordOrderAwaitingPaymentService(processedEvents, orders, Clock.fixed(NOW, ZoneOffset.UTC));
+
+    @Test
+    void storesThePlacedOrder() {
+        UUID orderId = UUID.randomUUID();
+
+        service.record(new PlacedOrder(UUID.randomUUID(), orderId, "EUR", new BigDecimal("39.98"), PLACED));
+
+        assertThat(stored).containsExactly(
+                new OrderAwaitingPayment(orderId, Money.of(new BigDecimal("39.98"), "EUR"), PLACED));
+    }
+
+    @Test
+    void redeliveredEventIsStoredOnce() {
+        PlacedOrder event = new PlacedOrder(UUID.randomUUID(), UUID.randomUUID(), "EUR", BigDecimal.TEN, PLACED);
+
+        service.record(event);
+        service.record(event);
+
+        assertThat(stored).hasSize(1);
+    }
+}
