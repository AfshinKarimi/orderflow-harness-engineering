+package com.orderflow.payment.application.service;
+
+import com.orderflow.payment.application.port.in.RecordOrderAwaitingPaymentUseCase;
+import com.orderflow.payment.application.port.out.OrdersAwaitingPayment;
+import com.orderflow.payment.application.port.out.PaymentProcessedEventStore;
+import com.orderflow.payment.domain.OrderAwaitingPayment;
+import com.orderflow.shared.domain.Money;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.time.Clock;
+
+/** Deduplication row and the stored order commit together, as in the order module (ADR-0003 §5). */
+@Service
+@Transactional
+public class RecordOrderAwaitingPaymentService implements RecordOrderAwaitingPaymentUseCase {
+
+    private final PaymentProcessedEventStore processedEvents;
+    private final OrdersAwaitingPayment ordersAwaitingPayment;
+    private final Clock clock;
+
+    public RecordOrderAwaitingPaymentService(PaymentProcessedEventStore processedEvents,
+                                             OrdersAwaitingPayment ordersAwaitingPayment, Clock clock) {
+        this.processedEvents = processedEvents;
+        this.ordersAwaitingPayment = ordersAwaitingPayment;
+        this.clock = clock;
+    }
+
+    @Override
+    public void record(PlacedOrder order) {
+        if (!processedEvents.markProcessed(order.eventId())) {
+            return;
+        }
+        ordersAwaitingPayment.add(new OrderAwaitingPayment(order.orderId(),
+                Money.of(order.totalAmount(), order.currency()), order.placedAt()), clock.instant());
+    }
+}
