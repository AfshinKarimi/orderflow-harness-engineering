+    private static List<OrderLine> requireWithinLimits(List<OrderLine> lines) {
+        if (lines.size() > MAX_LINES) {
+            throw new InvalidOrderException(
+                    "An order may have at most " + MAX_LINES + " lines, but has " + lines.size());
+        }
+        Money total = sum(lines);
+        if (total.amount().compareTo(MAX_TOTAL) > 0) {
+            throw new InvalidOrderException("Order total " + total.amount() + " " + total.currency()
+                    + " exceeds the limit of " + MAX_TOTAL + " " + total.currency());
+        }
+        return lines;
+    }
+
+    private static Money sum(List<OrderLine> lines) {
         return lines.stream()
                 .map(OrderLine::lineTotal)
-                .reduce(Money.zero(currency()), Money::add);
+                .reduce(Money.zero(lines.getFirst().unitPrice().currency()), Money::add);
+    }
+
+    public Money total() {
