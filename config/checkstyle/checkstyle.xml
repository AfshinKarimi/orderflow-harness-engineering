<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  OrderFlow Checkstyle rules. Small on purpose: every rule catches a likely bug, keeps imports and
  naming consistent, or enforces a project rule. Rationale per group: docs/quality/quality-tools.md.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="charset" value="UTF-8"/>
    <property name="fileExtensions" value="java"/>

    <!-- Layout -->
    <module name="FileTabCharacter"/>
    <module name="NewlineAtEndOfFile"/>
    <module name="LineLength">
        <property name="max" value="120"/>
    </module>

    <module name="TreeWalker">
        <!-- Likely bugs -->
        <module name="StringLiteralEquality"/>
        <module name="EqualsHashCode"/>
        <module name="CovariantEquals"/>
        <module name="EmptyCatchBlock"/>
        <module name="FallThrough"/>
        <module name="InnerAssignment"/>
        <module name="ModifiedControlVariable"/>
        <module name="NeedBraces"/>
        <module name="DefaultComesLast"/>
        <module name="NoFinalizer"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>

        <!-- Imports -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <!-- sun.*: internal JDK APIs. Disabled: tests must never be bypassed (ai-development-workflow.md, hard rule 1). -->
        <module name="IllegalImport">
            <property name="illegalPkgs" value="sun"/>
            <property name="illegalClasses" value="org.junit.jupiter.api.Disabled, org.junit.Ignore"/>
        </module>

        <!-- Naming -->
        <module name="PackageName">
            <property name="format" value="^com\.orderflow(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="ConstantName"/>
        <!-- ArchUnit reports @ArchTest field names as test names; keep them readable (rule1_domainDependsOn...) -->
        <module name="SuppressionXpathSingleFilter">
            <property name="checks" value="ConstantName"/>
            <property name="query" value="//VARIABLE_DEF[./MODIFIERS/ANNOTATION/IDENT[@text='ArchTest']]/IDENT"/>
        </module>

        <!-- Project rules: use logging, never print or swallow stack traces to the console -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\.|\.printStackTrace\("/>
            <property name="message" value="Use a logger instead of System.out/err or printStackTrace()"/>
            <property name="ignoreComments" value="true"/>
        </module>
    </module>
</module>
